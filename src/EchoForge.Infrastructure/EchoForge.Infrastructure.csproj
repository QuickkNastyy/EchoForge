<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EchoForge.Infrastructure</RootNamespace>
    <!--
      LibraryImport generates the marshalling stubs for the Job Object interop. The
      generated code is unsafe; nothing hand-written here is.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Infrastructure points inward at Core and Contracts. It deliberately does not reference
    Audio.Windows: recovery repairs chunks through IActiveChunkRepairer so the audio format
    knowledge stays in the audio layer and recovery stays testable with a fake.
  -->
  <ItemGroup>
    <ProjectReference Include="..\EchoForge.Contracts\EchoForge.Contracts.csproj" />
    <ProjectReference Include="..\EchoForge.Core\EchoForge.Core.csproj" />
  </ItemGroup>

  <!--
    SQLite lives here and only here. The index is a disposable projection: Core stays free of it
    so nothing that decides what a transcript or a summary *is* can start depending on a database.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EchoForge.UnitTests" />
  </ItemGroup>

</Project>
