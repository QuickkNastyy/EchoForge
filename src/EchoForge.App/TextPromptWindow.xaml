<Window x:Class="EchoForge.App.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="Rename"
        Width="430" Height="190" MinWidth="430" MinHeight="190"
        MaxWidth="430" MaxHeight="190"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="18,16,18,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="PromptText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBox x:Name="Input" Grid.Row="1" Margin="0,10,0,0" Padding="10,7"
             FontSize="14" MaxLength="160" />
    <TextBlock Grid.Row="2" Margin="0,7,0,0" FontSize="11.5" Foreground="{DynamicResource InkDim}"
               Text="Leave it blank to restore the default name." />

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
      <Button Content="Save" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnSave" />
    </StackPanel>
  </Grid>
</Window>
