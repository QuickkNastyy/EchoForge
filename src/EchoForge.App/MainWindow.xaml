<Window x:Class="EchoForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:EchoForge.App"
        xmlns:rec="clr-namespace:EchoForge.App.Recording"
        xmlns:lib="clr-namespace:EchoForge.App.Library"
        xmlns:setup="clr-namespace:EchoForge.App.Setup"
        Style="{StaticResource AppWindow}"
        Title="{Binding WindowTitle, FallbackValue=EchoForge}"
        Icon="pack://application:,,,/EchoForge.App;component/Assets/echoforge-mark.png"
        Height="640" Width="980" MinHeight="640" MinWidth="980"
        WindowStyle="None" AllowsTransparency="False"
        app:AppWindow.Accent="{Binding IndicatorVisible, Converter={StaticResource RecordingAccent}}"
        WindowStartupLocation="CenterScreen">

  <!--
    One window, three destinations, one rail.

    EchoForge used to be three top-level windows — the recorder, all recordings, and setup — which
    is how the same Transcribe and Generate summary controls came to exist in two places at once.
    Every page has one owner: Record records, Library is where a meeting is processed and read, and
    Settings owns every choice about models and runtimes.

    The window icon's pack URI is assembly-qualified on purpose: an unqualified one resolves
    against the entry assembly, which is this application when it runs and the test host when a
    render test builds the same window — where it throws rather than falling back.

    The rail is labelled — icon and word — and it is the only navigation in the application.
    Destinations sit above the divider; utilities below it. Settings expands in place, accordion
    style, exposing its sections (and the theme toggle) as sub-items instead of a second sidebar.
  -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Width="190" Background="{DynamicResource Panel}"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="10,12,10,12" LastChildFill="False">

<!--
          The mark. Painted from a raster authored at twice this size and sharpened for it: the
          logo is a bevelled ring around a waveform, and the detail it is made of averages into a
          green blob if WPF is asked to resample the full-resolution artwork down to 32 pixels.
        -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="9,0,0,14">
<!--
            Inside a Viewbox, so the strokes scale with the geometry. A Path's StrokeThickness is
            in device units and Stretch does not scale it, so the mark drawn directly at 30px wore
            an eleven-pixel stroke and filled itself in as a solid disc.
          -->
          <Viewbox Width="30" Height="30" VerticalAlignment="Center" Stretch="Uniform"
                   AutomationProperties.Name="EchoForge">
            <Canvas Width="100" Height="100">
              <Path Data="{StaticResource MarkRing}"
                    Stroke="{DynamicResource Focus}" StrokeThickness="10"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              <Path Data="{StaticResource MarkWave}"
                    Stroke="{DynamicResource Focus}" StrokeThickness="7"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>
          </Viewbox>
          <TextBlock Text="EchoForge" Margin="10,0,0,0" VerticalAlignment="Center"
                     FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Ink}" />
        </StackPanel>

        <Button DockPanel.Dock="Top" Style="{StaticResource NavButton}"
                AutomationProperties.Name="Record"
                Command="{Binding ShowRecordCommand}"
                Tag="{Binding IsRecordPage, Converter={StaticResource ActiveTag}}">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconRecord}" />
            <TextBlock Text="Record" />
          </StackPanel>
        </Button>

        <Button DockPanel.Dock="Top" Style="{StaticResource NavButton}"
                AutomationProperties.Name="Recordings"
                Command="{Binding ShowRecordingsCommand}"
                Tag="{Binding IsRecordingsPage, Converter={StaticResource ActiveTag}}">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconLibrary}" />
            <TextBlock Text="Library" />
          </StackPanel>
        </Button>

        <!-- Destinations above; utilities below. The line is the boundary. -->
        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Line}" Margin="6,10" />

        <Button DockPanel.Dock="Top" Style="{StaticResource NavButton}"
                AutomationProperties.Name="Compact recorder"
                ToolTip="Open the small always-on-top recorder"
                Click="OnCompact">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconCompact}" />
            <TextBlock Text="Compact view" />
          </StackPanel>
        </Button>

        <Button DockPanel.Dock="Top" Style="{StaticResource NavButton}"
                AutomationProperties.Name="Settings"
                ToolTip="Settings, models and runtime"
                Command="{Binding ShowSettingsCommand}"
                Tag="{Binding IsSettingsPage, Converter={StaticResource ActiveTag}}">
          <DockPanel Width="146">
            <Path DockPanel.Dock="Right" Width="9" Height="6" Stretch="Uniform" VerticalAlignment="Center"
                  Data="M 0 0 L 4 4 L 8 0" StrokeThickness="1.6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  RenderTransformOrigin="0.5,0.5">
              <Path.Style>
                <Style TargetType="Path">
                  <Setter Property="RenderTransform">
                    <Setter.Value>
                      <RotateTransform Angle="-90" />
                    </Setter.Value>
                  </Setter>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                      <Setter Property="RenderTransform">
                        <Setter.Value>
                          <RotateTransform Angle="0" />
                        </Setter.Value>
                      </Setter>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Path.Style>
            </Path>
            <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconSetup}" />
            <TextBlock Text="Settings" />
          </DockPanel>
        </Button>

        <!--
          The Settings accordion. It expands when Settings is the page and collapses when it is
          not; each sub-item is a section of the one Settings page, and Theme lives here because
          it is a preference, not a destination.
        -->
        <StackPanel DockPanel.Dock="Top"
                    Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVis}}">
          <Button Style="{StaticResource SubNavButton}" Content="Transcription"
                  AutomationProperties.Name="Transcription settings"
                  Command="{Binding ShowTranscriptionSettingsCommand}"
                  Tag="{Binding IsTranscriptionSection, Converter={StaticResource ActiveTag}}" />
          <Button Style="{StaticResource SubNavButton}" Content="Meeting briefs"
                  AutomationProperties.Name="Meeting brief settings"
                  Command="{Binding ShowBriefsSettingsCommand}"
                  Tag="{Binding IsBriefsSection, Converter={StaticResource ActiveTag}}" />
          <Button Style="{StaticResource SubNavButton}" Content="Models"
                  AutomationProperties.Name="Model settings"
                  Command="{Binding ShowModelsSettingsCommand}"
                  Tag="{Binding IsModelsSection, Converter={StaticResource ActiveTag}}" />
          <Button Style="{StaticResource SubNavButton}" Content="This machine"
                  AutomationProperties.Name="Machine settings"
                  Command="{Binding ShowMachineSettingsCommand}"
                  Tag="{Binding IsMachineSection, Converter={StaticResource ActiveTag}}" />
          <Button Style="{StaticResource SubNavButton}" Content="Compare models"
                  AutomationProperties.Name="Compare models"
                  Command="{Binding ShowCompareSettingsCommand}"
                  Tag="{Binding IsCompareSection, Converter={StaticResource ActiveTag}}" />

          <Border Height="1" Background="{DynamicResource Line}" Margin="24,6,6,6" />

          <Button Style="{StaticResource SubNavButton}"
                  AutomationProperties.Name="Switch theme"
                  ToolTip="Switch between the light and dark theme"
                  Command="{x:Static app:Theme.ToggleCommand}">
            <StackPanel Orientation="Horizontal">
              <Path Width="13" Height="13" Margin="0,0,8,0" Stretch="Uniform" VerticalAlignment="Center"
                    Data="{StaticResource IconTheme}" StrokeThickness="1.5"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              <TextBlock Text="Theme" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Background="{DynamicResource Surface}">
      <rec:RecordPage Visibility="{Binding IsRecordPage, Converter={StaticResource BoolToVis}}" />

      <lib:RecordingsPage DataContext="{Binding Library}"
                          Visibility="{Binding DataContext.IsRecordingsPage,
                                       RelativeSource={RelativeSource AncestorType=Window},
                                       Converter={StaticResource BoolToVis}}" />

      <setup:SettingsPage Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVis}}" />
    </Grid>
  </Grid>
</Window>
