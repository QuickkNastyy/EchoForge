<Window x:Class="EchoForge.App.SummaryComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compare summary revisions" Width="1120" Height="740"
        MinWidth="800" MinHeight="500" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="SUMMARY MODEL COMPARISON" FontWeight="SemiBold" Foreground="{DynamicResource InkDim}" />
      <TextBlock Margin="0,6,0,0" Text="Both summaries were generated from the same immutable transcript revision. Missing decisions, actions, and details stay visible; no automatic winner is declared."
                 TextWrapping="Wrap" Foreground="{DynamicResource InkDim}" />
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,16,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="116" /><ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="1">
        <TextBlock Text="{Binding LeftHeading}" FontSize="17" FontWeight="SemiBold" />
        <TextBlock Margin="0,4,0,0" Text="{Binding LeftDetails}" Foreground="{DynamicResource InkDim}" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="3">
        <TextBlock Text="{Binding RightHeading}" FontSize="17" FontWeight="SemiBold" />
        <TextBlock Margin="0,4,0,0" Text="{Binding RightDetails}" Foreground="{DynamicResource InkDim}" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,7" Padding="9" CornerRadius="4" BorderThickness="1" Background="{DynamicResource CardFill}">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                      <Setter Property="BorderBrush" Value="{DynamicResource Rec}" />
                      <Setter Property="Background" Value="{DynamicResource RecWash}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="108" /><ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding Section}" FontWeight="SemiBold" Foreground="{DynamicResource Remote}" TextWrapping="Wrap" />
                  <TextBlock Margin="0,4,0,0" Text="{Binding Agreement}" Foreground="{DynamicResource InkDim}" FontSize="10" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding LeftText}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="3" Text="{Binding RightText}" TextWrapping="Wrap" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</Window>
