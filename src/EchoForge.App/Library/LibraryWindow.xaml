<Window x:Class="EchoForge.App.Library.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EchoForge — meetings" Height="820" Width="1180"
        Background="{StaticResource Surface}" Foreground="{StaticResource Ink}">

  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="360" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Meetings and search -->
    <DockPanel Grid.Column="0" Margin="0,0,14,0">
      <StackPanel DockPanel.Dock="Top">
        <TextBlock Text="SEARCH" Style="{StaticResource Label}" Margin="0,0,0,6" />
        <DockPanel Margin="0,0,0,8">
          <Button DockPanel.Dock="Right" Content="Find" Margin="8,0,0,0"
                  Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}" />
          <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Words must all appear. Put a phrase in quotes to match it exactly.">
            <TextBox.InputBindings>
              <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
            </TextBox.InputBindings>
          </TextBox>
        </DockPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Button Content="Clear" Command="{Binding ClearSearchCommand}" Margin="0,0,8,0" />
          <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
          <Button Content="Rebuild index" Command="{Binding RebuildCommand}"
                  ToolTip="The index is a cache. Rebuilding it never touches your recordings." />
        </StackPanel>

        <!--
          Dates are a query, never a rebuild: the index already knows when every meeting was.
          Both ends are whole local days, and both are included.
        -->
        <TextBlock Text="DATES" Style="{StaticResource Label}" Margin="0,4,0,6" />
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <DatePicker Grid.Column="0" SelectedDate="{Binding FromDate, Mode=TwoWay}"
                      ToolTip="The first day to include, in your own time zone." />
          <TextBlock Grid.Column="1" Text=" to " VerticalAlignment="Center"
                     Style="{StaticResource Label}" Foreground="{StaticResource InkDim}" />
          <DatePicker Grid.Column="2" SelectedDate="{Binding ToDate, Mode=TwoWay}"
                      ToolTip="The last day to include, in your own time zone." />
          <Button Grid.Column="3" Content="Clear" Margin="8,0,0,0" Command="{Binding ClearDatesCommand}" />
        </Grid>

        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{StaticResource InkDim}"
                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />
      </StackPanel>

      <!-- Results, when there are any -->
      <ListBox x:Name="ResultsList" DockPanel.Dock="Top" MaxHeight="300" Margin="0,0,0,10"
               ItemsSource="{Binding Results}"
               Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}"
               MouseDoubleClick="OnResultActivated"
               VirtualizingStackPanel.IsVirtualizing="True"
               VirtualizingStackPanel.VirtualizationMode="Recycling"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,3">
              <TextBlock Text="{Binding Where}" Style="{StaticResource Label}" Foreground="{StaticResource You}" />
              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding MeetingTitle}" Style="{StaticResource Label}" Foreground="{StaticResource InkDim}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock DockPanel.Dock="Top" Text="MEETINGS" Style="{StaticResource Label}" Margin="0,0,0,6" />

      <ListBox ItemsSource="{Binding Meetings}" SelectedItem="{Binding SelectedMeeting, Mode=TwoWay}"
               VirtualizingStackPanel.IsVirtualizing="True"
               VirtualizingStackPanel.VirtualizationMode="Recycling"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,4">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding When}" Style="{StaticResource Label}" Foreground="{StaticResource InkDim}" />
                <TextBlock Text="  ·  " Style="{StaticResource Label}" Foreground="{StaticResource InkDim}" />
                <TextBlock Text="{Binding Length}" Style="{StaticResource Label}" Foreground="{StaticResource InkDim}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <TextBlock Text="transcript" Style="{StaticResource Label}" Foreground="{StaticResource You}" Margin="0,0,8,0"
                           Visibility="{Binding HasTranscript, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="summary" Style="{StaticResource Label}" Foreground="{StaticResource You}" Margin="0,0,8,0"
                           Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="stale summary" Style="{StaticResource Label}" Foreground="#D8A657" Margin="0,0,8,0"
                           Visibility="{Binding SummaryIsStale, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="needs attention" Style="{StaticResource Label}" Foreground="{StaticResource Rec}"
                           ToolTip="{Binding AttentionReason}"
                           Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVis}}" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- The open meeting -->
    <Grid Grid.Column="1" DataContext="{Binding OpenMeeting}">
      <TextBlock Text="Select a meeting to read its transcript and summary."
                 Foreground="{StaticResource InkDim}" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <DockPanel>
        <DockPanel.Style>
          <Style TargetType="DockPanel">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DockPanel.Style>

        <!--
          Playback. A transport and a line to drag, not a waveform editor: the timeline is one
          control whatever the meeting's length, so a three-hour recording costs the same as a
          three-minute one.
        -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="10,8" CornerRadius="4"
                Background="#14171A" BorderBrush="#2A2F35" BorderThickness="1"
                Visibility="{Binding CanPlay, Converter={StaticResource BoolToVis}}"
                DataContext="{Binding Playback}">
          <StackPanel>
            <DockPanel>
              <Button DockPanel.Dock="Left" MinWidth="70" Content="{Binding PlayPauseLabel}"
                      Command="{Binding PlayPauseCommand}" Style="{StaticResource PrimaryButton}" />
              <Button DockPanel.Dock="Left" Content="Stop" Margin="8,0,0,0" Command="{Binding StopCommand}" />

              <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center"
                         Style="{StaticResource Label}" Foreground="{StaticResource InkDim}"
                         Text="{Binding DurationText}" />
              <TextBlock DockPanel.Dock="Left" Margin="12,0,8,0" VerticalAlignment="Center" MinWidth="52"
                         Style="{StaticResource Label}" Foreground="{StaticResource Ink}"
                         Text="{Binding PositionText}" />

              <Slider x:Name="Timeline" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                      Minimum="0" Maximum="{Binding DurationSeconds, Mode=OneWay}"
                      Value="{Binding PositionSeconds, Mode=OneWay}"
                      Thumb.DragStarted="OnTimelineDragStarted"
                      Thumb.DragCompleted="OnTimelineDragCompleted"
                      PreviewMouseLeftButtonUp="OnTimelineClicked" />
            </DockPanel>

            <ProgressBar Height="3" Margin="0,6,0,0" Minimum="0" Maximum="1"
                         Value="{Binding PreparationFraction, Mode=OneWay}"
                         Visibility="{Binding IsPreparing, Converter={StaticResource BoolToVis}}" />

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <CheckBox Content="Mute You" IsChecked="{Binding MuteYou, Mode=TwoWay}" Margin="0,0,12,0"
                        IsEnabled="{Binding HasYouTrack}" />
              <CheckBox Content="Mute Remote" IsChecked="{Binding MuteRemote, Mode=TwoWay}"
                        IsEnabled="{Binding HasRemoteTrack}" />
            </StackPanel>

            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{StaticResource InkDim}"
                       Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}" />

            <TextBlock Text="{Binding SeekNotice}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="#D8A657"
                       Visibility="{Binding HasSeekNotice, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
        </Border>

        <!-- Reprocessing and deletion, on the meeting rather than on the main window. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
          <Button Content="Transcribe again" Margin="0,0,8,0"
                  Command="{Binding DataContext.TranscribeAgainCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  ToolTip="Creates a new transcript version. Earlier versions stay exactly as they are." />
          <Button Content="Generate summary again" Margin="0,0,8,0"
                  Command="{Binding DataContext.SummarizeAgainCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  ToolTip="Uses the transcript version selected here, and creates a new summary version." />
          <Button Content="Delete meeting…"
                  Command="{Binding DataContext.DeleteMeetingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  ToolTip="Asks first, and moves the whole recording to the Recycle Bin." />
        </StackPanel>

        <TabControl Background="Transparent" BorderThickness="0">

        <!-- Transcript -->
        <TabItem Header="Transcript">
          <DockPanel Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <TextBlock Text="{Binding TranscriptModelText}" Style="{StaticResource Label}" Foreground="{StaticResource InkDim}" />
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Version" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox MinWidth="80" ItemsSource="{Binding TranscriptRevisions}"
                          SelectedItem="{Binding SelectedTranscriptRevision, Mode=TwoWay}" />
                <Button Content="Export…" Margin="12,0,0,0" Click="OnExportTranscript" />
              </StackPanel>
            </StackPanel>

            <!--
              Virtualized and recycling. A three-hour meeting is tens of thousands of lines, and
              materialising a control for each one is the difference between a list that opens
              and an application that stops responding.
            -->
            <ListBox x:Name="TranscriptList" ItemsSource="{Binding Lines}"
                     SelectionMode="Extended"
                     MouseDoubleClick="OnTranscriptLineActivated"
                     ToolTip="Double-click a line to move the audio to that moment."
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="76" />
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Timestamp}" Style="{StaticResource Label}"
                               Foreground="{StaticResource InkDim}" />
                    <TextBlock Grid.Column="1" Text="{Binding Speaker}" Style="{StaticResource Label}"
                               Foreground="{StaticResource You}" TextTrimming="CharacterEllipsis" />
                    <TextBox Grid.Column="2" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True"
                             BorderThickness="0" Background="Transparent" Foreground="{StaticResource Ink}"
                             TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </TabItem>

        <!-- Summary -->
        <TabItem Header="Summary">
          <DockPanel Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <TextBlock Text="{Binding SummaryModelText}" Style="{StaticResource Label}" Foreground="{StaticResource InkDim}" />

              <Border Margin="0,8,0,0" CornerRadius="4" Padding="10,8"
                      Background="#1E1A12" BorderBrush="#D8A657" BorderThickness="1"
                      Visibility="{Binding SummaryIsStale, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                  <TextBlock Text="{Binding StaleNotice}" TextWrapping="Wrap" Foreground="{StaticResource Ink}" />
                  <Button Content="Generate again from the selected transcript" Margin="0,8,0,0"
                          HorizontalAlignment="Left" Click="OnRegenerateSummary" />
                </StackPanel>
              </Border>

              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Version" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox MinWidth="80" ItemsSource="{Binding SummaryRevisions}"
                          SelectedItem="{Binding SelectedSummaryRevision, Mode=TwoWay}" />
                <Button Content="Export…" Margin="12,0,0,0" Click="OnExportSummary" />
              </StackPanel>

              <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Margin="0,8,0,0"
                         Foreground="{StaticResource InkDim}"
                         Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}" />

              <TextBlock Text="OVERVIEW" Style="{StaticResource Label}" Margin="0,12,0,4" />
              <TextBox Text="{Binding SummaryOverview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                       BorderThickness="0" Background="Transparent" Foreground="{StaticResource Ink}" />
            </StackPanel>

            <ListBox x:Name="SummaryList" ItemsSource="{Binding SummaryLines}"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnEvidenceActivated">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,4">
                    <TextBlock Text="{Binding Section}" Style="{StaticResource Label}" Foreground="{StaticResource InkDim}" />
                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             BorderThickness="0" Background="Transparent" Foreground="{StaticResource Ink}" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Label}" Foreground="{StaticResource InkDim}" />
                    <TextBlock Text="{Binding EvidenceLabel}" Style="{StaticResource Label}"
                               Foreground="{StaticResource You}"
                               ToolTip="Double-click to open the transcript at this moment"
                               Visibility="{Binding HasEvidence, Converter={StaticResource BoolToVis}}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </TabItem>

        <!-- Speakers -->
        <TabItem Header="Speakers">
          <StackPanel Margin="0,10,0,0">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource InkDim}"
                       Text="Renaming a remote speaker changes what you see and nothing else. The transcript is not rewritten, evidence still points at the same words, and clearing a name restores the original. You is derived from your microphone and cannot be renamed." />
            <ItemsControl ItemsSource="{Binding Speakers}" Margin="0,12,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,4">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding OriginalName}" Width="90"
                               Style="{StaticResource Label}" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0" Click="OnResetSpeaker" />
                    <TextBox Text="{Binding DisplayName, Mode=OneWay}" Tag="{Binding SpeakerId}"
                             KeyDown="OnSpeakerNameCommitted" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </TabItem>
      </TabControl>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
