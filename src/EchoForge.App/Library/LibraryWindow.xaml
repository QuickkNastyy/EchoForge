<Window x:Class="EchoForge.App.Library.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lib="clr-namespace:EchoForge.App.Library"
        Title="EchoForge — recordings" Height="860" Width="1240" MinHeight="560" MinWidth="900"
        lib:MiniRibbon.Provider="{Binding LoadShapeProvider}"
        Background="{StaticResource Surface}" Foreground="{StaticResource Ink}"
        FontFamily="{StaticResource UiFont}">

  <Grid Margin="22,18,22,18">

    <!-- ============================ ALL RECORDINGS (scene 05) ============================ -->
    <DockPanel Visibility="{Binding HasOpenMeeting, Converter={StaticResource InvBoolToVis}}">

      <TextBlock DockPanel.Dock="Top" Text="All recordings" Margin="0,0,0,12"
                 FontFamily="{StaticResource DataFont}" FontSize="20" FontWeight="SemiBold" />

      <!-- Search + filters -->
      <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource Sunken}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="6" Padding="10,2">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="⌕" VerticalAlignment="Center" Foreground="{StaticResource InkFaint}"
                       FontSize="14" Margin="0,0,8,0" />
            <Button DockPanel.Dock="Right" Content="Find" Command="{Binding SearchCommand}"
                    Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" />
            <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearSearchCommand}" Margin="6,4,0,4" />
            <TextBox VerticalAlignment="Center" BorderThickness="0" Background="Transparent"
                     Foreground="{StaticResource Ink}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Search every recording and transcript. Put a phrase in quotes to match it exactly.">
              <TextBox.InputBindings>
                <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
              </TextBox.InputBindings>
            </TextBox>
          </DockPanel>
        </Border>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="From" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,6,0" />
          <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" Width="120" />
          <TextBlock Text="to" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="8,0,6,0" />
          <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" Width="120" />
          <Button Content="Clear" Command="{Binding ClearDatesCommand}" Margin="8,0,0,0" />
          <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="6,0,0,0" />
          <Button Content="Rebuild index" Command="{Binding RebuildCommand}" Margin="6,0,0,0"
                  ToolTip="The index is a cache. Rebuilding it never touches your recordings." />
        </StackPanel>
      </Grid>

      <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,8"
                 Foreground="{StaticResource InkDim}"
                 Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />

      <!-- Search results, when a search is active -->
      <ListBox x:Name="ResultsList" DockPanel.Dock="Top" MaxHeight="240" Margin="0,0,0,10"
               ItemsSource="{Binding Results}"
               Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}"
               MouseDoubleClick="OnResultActivated"
               Background="{StaticResource Sunken}"
               VirtualizingStackPanel.IsVirtualizing="True"
               VirtualizingStackPanel.VirtualizationMode="Recycling"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="2,3">
              <TextBlock Text="{Binding Where}" Style="{StaticResource Label}" Foreground="{StaticResource You}" />
              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding MeetingTitle}" Style="{StaticResource Label}" Foreground="{StaticResource InkDim}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- The recordings, grouped by day. Selecting one opens it. -->
      <ListBox x:Name="MeetingsList" ItemsSource="{Binding Meetings}"
               SelectedItem="{Binding SelectedMeeting, Mode=TwoWay}"
               Background="Transparent" BorderThickness="0"
               HorizontalContentAlignment="Stretch"
               VirtualizingStackPanel.IsVirtualizing="True"
               VirtualizingStackPanel.VirtualizationMode="Recycling"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <DockPanel Margin="2,16,2,6">
                  <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Style="{StaticResource Label}" />
                  <TextBlock DockPanel.Dock="Right" Style="{StaticResource Label}" Foreground="{StaticResource InkFaint}">
                    <Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=" recording(s)" />
                  </TextBlock>
                  <Border Height="1" Background="{StaticResource Line}" Margin="12,0" VerticalAlignment="Center" />
                </DockPanel>
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ListBox.GroupStyle>
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Row" CornerRadius="6" Background="{TemplateBinding Background}"
                          BorderBrush="Transparent" BorderThickness="1" Padding="12,10">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Row" Property="Background" Value="{StaticResource Sunken}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Row" Property="Background" Value="{StaticResource Raised}" />
                      <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Line}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="26" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Sub}" Style="{StaticResource Label}" Foreground="{StaticResource InkFaint}" Margin="0,2,0,0" />
              </StackPanel>

              <lib:MiniRibbon Grid.Column="1" Height="22" Margin="12,0" VerticalAlignment="Center"
                              SessionId="{Binding SessionId}" />

              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                <TextBlock Text="transcript" Style="{StaticResource Label}" Foreground="{StaticResource You}" Margin="0,0,8,0"
                           Visibility="{Binding HasTranscript, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="summary" Style="{StaticResource Label}" Foreground="{StaticResource You}" Margin="0,0,8,0"
                           Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="stale" Style="{StaticResource Label}" Foreground="#D8A657"
                           Visibility="{Binding SummaryIsStale, Converter={StaticResource BoolToVis}}" />
              </StackPanel>

              <Border Grid.Column="3" Style="{StaticResource Chip}" Margin="8,0">
                <TextBlock Text="{Binding Chip}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource ChipText}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ChipIsWarn}" Value="True">
                          <Setter Property="Foreground" Value="{StaticResource Rec}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Border>

              <TextBlock Grid.Column="4" Text="›" FontSize="16" Foreground="{StaticResource InkFaint}"
                         VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- ============================ ONE RECORDING (scenes 06/07) ============================ -->
    <!--
      The visibility and the data context are deliberately on different elements.

      Setting DataContext on an element re-scopes every other binding on that same element, so a
      Visibility bound to HasOpenMeeting alongside DataContext="{Binding OpenMeeting}" was asking a
      MeetingViewModel — or, with nothing open, null — for a property it has never had. The binding
      found no source, Visibility fell back to its default of Visible, and the whole workspace was
      drawn on top of the list: the back button over the "All recordings" heading, an empty amber
      panel where the stale-summary warning would go, a blank transport, and a black timeline well.
    -->
    <Grid Visibility="{Binding HasOpenMeeting, Converter={StaticResource BoolToVis}}">
    <DockPanel DataContext="{Binding OpenMeeting}">

      <!-- Header -->
      <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Content="‹ All recordings" Click="OnBackToList" VerticalAlignment="Center" Margin="0,0,16,0" />

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DataFont}" FontSize="19" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Style="{StaticResource Label}" Foreground="{StaticResource InkFaint}" Margin="0,3,0,0">
            <Run Text="{Binding TranscriptModelText, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="{Binding DataContext.TranscribeActionLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                  Command="{Binding DataContext.TranscribeAgainCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  Margin="0,0,8,0" ToolTip="Creates a new transcript version. Earlier versions stay exactly as they are." />
          <Button Content="{Binding DataContext.SummarizeActionLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                  Command="{Binding DataContext.SummarizeAgainCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  Margin="0,0,8,0" ToolTip="Uses the transcript version selected here, and creates a new summary version." />
          <Button Content="Export transcript…" Click="OnExportTranscript" Margin="0,0,8,0" />
          <Button Content="Copy for ChatGPT / Claude…" Click="OnCopyForAssistant" Margin="0,0,8,0" />
          <Button Content="Delete…" Style="{StaticResource DangerButton}"
                  Command="{Binding DataContext.DeleteMeetingCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        </StackPanel>
      </Grid>

      <!-- Timeline: the conversation ribbon is the transport. Click it to seek. -->
      <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="10,9" CornerRadius="6"
              Background="{StaticResource Sunken}" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <StackPanel>
          <lib:MiniRibbon x:Name="TimelineRibbon" Height="92" ShowRuler="True"
                          Shape="{Binding Shape}"
                          DurationSeconds="{Binding Playback.DurationSeconds, FallbackValue=0}"
                          PlayheadFraction="{Binding Playback.PositionFraction, FallbackValue=-1}"
                          MouseLeftButtonDown="OnTimelineRibbonClicked"
                          Cursor="Hand" ToolTip="Click to play from this moment" />

          <!-- Same rule as the workspace above: the gate reads the meeting, the row reads the
               transport, and they cannot be the same element. -->
          <Grid Visibility="{Binding CanPlay, Converter={StaticResource BoolToVis}}">
          <DockPanel DataContext="{Binding Playback}">
            <Button DockPanel.Dock="Left" MinWidth="72" Content="{Binding PlayPauseLabel}"
                    Command="{Binding PlayPauseCommand}" Style="{StaticResource PrimaryButton}" />
            <Button DockPanel.Dock="Left" Content="Stop" Margin="8,0,0,0" Command="{Binding StopCommand}" />
            <TextBlock DockPanel.Dock="Left" Margin="14,0,0,0" VerticalAlignment="Center"
                       FontFamily="{StaticResource DataFont}" FontSize="12" Foreground="{StaticResource InkDim}">
              <Run Text="{Binding PositionText, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding DurationText, Mode=OneWay}" />
            </TextBlock>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <CheckBox Content="Mute You" IsChecked="{Binding MuteYou, Mode=TwoWay}" Margin="0,0,12,0"
                        IsEnabled="{Binding HasYouTrack}" VerticalAlignment="Center" />
              <CheckBox Content="Mute Remote" IsChecked="{Binding MuteRemote, Mode=TwoWay}"
                        IsEnabled="{Binding HasRemoteTrack}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding SeekNotice}" TextWrapping="Wrap" Margin="14,0,0,0" VerticalAlignment="Center"
                       Foreground="#D8A657"
                       Visibility="{Binding HasSeekNotice, Converter={StaticResource BoolToVis}}" />
          </DockPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Summary and transcript, side by side: a claim and its evidence at the same time. -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.05*" MinWidth="320" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="0.95*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- LEFT: the summary as one document -->
        <DockPanel Grid.Column="0">
          <StackPanel DockPanel.Dock="Top">
            <DockPanel Margin="0,0,0,6">
              <TextBlock DockPanel.Dock="Left" Text="SUMMARY" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ComboBox MinWidth="60" ItemsSource="{Binding SummaryRevisions}"
                          SelectedItem="{Binding SelectedSummaryRevision, Mode=TwoWay}" Margin="0,0,8,0" />
                <Button Content="Export…" Click="OnExportSummary" />
              </StackPanel>
              <TextBlock Text="{Binding SummaryModelText}" Style="{StaticResource Label}" Foreground="{StaticResource InkFaint}"
                         VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <Border CornerRadius="4" Padding="10,8" Margin="0,0,0,8"
                    Background="#1E1A12" BorderBrush="#D8A657" BorderThickness="1"
                    Visibility="{Binding SummaryIsStale, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <TextBlock Text="{Binding StaleNotice}" TextWrapping="Wrap" Foreground="{StaticResource Ink}" />
                <Button Content="Generate again from the selected transcript" Margin="0,8,0,0"
                        HorizontalAlignment="Left" Click="OnRegenerateSummary" />
              </StackPanel>
            </Border>

            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Foreground="{StaticResource InkDim}"
                       Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}" />

            <Border CornerRadius="6" Padding="12" Margin="0,0,0,8"
                    Background="{StaticResource Sunken}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <TextBlock Text="OVERVIEW" Style="{StaticResource Label}" Margin="0,0,0,5" />
                <TextBox Text="{Binding SummaryOverview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         BorderThickness="0" Background="Transparent" Foreground="{StaticResource Ink}" />
              </StackPanel>
            </Border>

            <TextBlock Text="No summary yet. Use Generate summary above once there is a transcript."
                       TextWrapping="Wrap" Foreground="{StaticResource InkFaint}" Margin="0,4,0,8"
                       Visibility="{Binding HasSummary, Converter={StaticResource InvBoolToVis}}" />
          </StackPanel>

          <!-- Claims. Selecting one scrolls the transcript and cues the audio. -->
          <ListBox x:Name="SummaryList" ItemsSource="{Binding SummaryLines}"
                   Background="Transparent" BorderThickness="0"
                   HorizontalContentAlignment="Stretch"
                   SelectionChanged="OnSummarySelectionChanged"
                   VirtualizingStackPanel.IsVirtualizing="True"
                   VirtualizingStackPanel.VirtualizationMode="Recycling"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="10,8" Margin="0,2" CornerRadius="6" Background="Transparent">
                  <StackPanel>
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Left" Text="{Binding Section}" Style="{StaticResource Label}"
                                 Foreground="{StaticResource InkDim}" />
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Certainty}" Style="{StaticResource Label}"
                                 Foreground="{StaticResource InkFaint}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,3,0,0"
                             BorderThickness="0" Background="Transparent" Foreground="{StaticResource Ink}" />
                    <DockPanel Margin="0,4,0,0">
                      <TextBlock DockPanel.Dock="Left" Text="{Binding Detail}" Style="{StaticResource Label}"
                                 Foreground="{StaticResource InkDim}" />
                      <TextBlock DockPanel.Dock="Right" Text="{Binding EvidenceLabel}" Style="{StaticResource Label}"
                                 Foreground="{StaticResource You}" HorizontalAlignment="Right"
                                 ToolTip="Click this item to open the transcript here and play from the source"
                                 Visibility="{Binding HasEvidence, Converter={StaticResource BoolToVis}}" />
                    </DockPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- RIGHT: the transcript -->
        <Border Grid.Column="2" Background="{StaticResource Sunken}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="6" Padding="12,10">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <TextBlock DockPanel.Dock="Left" Text="TRANSCRIPT" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="Version" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox MinWidth="60" ItemsSource="{Binding TranscriptRevisions}"
                          SelectedItem="{Binding SelectedTranscriptRevision, Mode=TwoWay}" />
              </StackPanel>
              <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                      CornerRadius="5" Padding="8,2" Margin="12,0">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Text="⌕" Foreground="{StaticResource InkFaint}" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <TextBox x:Name="TranscriptSearch" BorderThickness="0" Background="Transparent" Width="150"
                           Foreground="{StaticResource Ink}" VerticalAlignment="Center"
                           TextChanged="OnTranscriptSearchChanged"
                           ToolTip="Find within this recording" />
                </DockPanel>
              </Border>
            </DockPanel>

            <!-- Speaker aliases, tucked under the transcript header -->
            <Expander DockPanel.Dock="Bottom" Header="Speaker names" Margin="0,8,0,0" Foreground="{StaticResource InkDim}">
              <StackPanel Margin="0,6,0,0">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource InkFaint}" Style="{StaticResource Label}"
                           Text="Renaming a remote speaker changes what you see and nothing else. You is derived from your microphone and cannot be renamed." />
                <ItemsControl ItemsSource="{Binding Speakers}" Margin="0,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,3">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding OriginalName}" Width="90"
                                   Style="{StaticResource Label}" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="Reset" Margin="8,0,0,0" Click="OnResetSpeaker" />
                        <TextBox Text="{Binding DisplayName, Mode=OneWay}" Tag="{Binding SpeakerId}"
                                 KeyDown="OnSpeakerNameCommitted" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Expander>

            <ListBox x:Name="TranscriptList" ItemsSource="{Binding Lines}"
                     Background="Transparent" BorderThickness="0"
                     SelectionMode="Extended" HorizontalContentAlignment="Stretch"
                     MouseDoubleClick="OnTranscriptLineActivated"
                     ToolTip="Double-click a line to play from that moment."
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="64" />
                      <ColumnDefinition Width="66" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Timestamp}" FontFamily="{StaticResource DataFont}"
                               FontSize="11" Foreground="{StaticResource InkFaint}" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Speaker}" FontFamily="{StaticResource DataFont}" FontSize="10"
                               VerticalAlignment="Top" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{StaticResource Remote}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsYou}" Value="True">
                              <Setter Property="Foreground" Value="{StaticResource You}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBox Grid.Column="2" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True"
                             BorderThickness="0" Background="Transparent" Foreground="{StaticResource Ink}"
                             TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </Grid>
    </DockPanel>
    </Grid>
  </Grid>
</Window>
