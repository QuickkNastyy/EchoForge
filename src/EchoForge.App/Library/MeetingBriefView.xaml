<UserControl x:Class="EchoForge.App.Library.MeetingBriefView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    The meeting brief, as one readable document.

    This is the product. It is not a sidebar beside the transcript and it is not a grid of
    extracted-fact cards with certainty pills on them: it is prose, then a numbered plan, then the
    few sections this particular meeting earned. Evidence is one click away on every claim and
    nowhere near the front of it.
  -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                Padding="0,12,14,0">
    <StackPanel MaxWidth="900" HorizontalAlignment="Left">

      <!-- Nothing processed yet. -->
      <Border CornerRadius="6" Padding="16,14" Margin="0,0,0,10"
              Background="{DynamicResource Sunken}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
              Visibility="{Binding HasSummary, Converter={StaticResource InvBoolToVis}}">
        <StackPanel>
          <TextBlock Text="Not processed yet" FontWeight="SemiBold" FontSize="14"
                     Foreground="{DynamicResource Ink}" />
          <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource InkDim}"
                     Text="Process this meeting to read what happened, what was decided, and what you need to do about it. It uses the models chosen in Settings; you are not asked to choose one per meeting." />
        </StackPanel>
      </Border>

      <!-- A brief written from an older transcript still says exactly what it said. -->
      <Border CornerRadius="6" Padding="12,10" Margin="0,0,0,10"
              Background="{DynamicResource WarnWash}" BorderBrush="{DynamicResource Warn}" BorderThickness="1"
              Visibility="{Binding SummaryIsStale, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="{Binding StaleNotice}" TextWrapping="Wrap" Foreground="{DynamicResource Ink}" />
      </Border>

      <!-- ===================== Summary ===================== -->
      <StackPanel Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="Summary" FontFamily="{StaticResource DisplayFont}" FontSize="17"
                   FontWeight="SemiBold" Margin="0,0,0,8" />

        <ItemsControl ItemsSource="{Binding BriefSummary}" Margin="0,0,0,6">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBox Text="{Binding Text, Mode=OneWay}" Style="{StaticResource ReadingText}"
                       FontSize="14" Margin="0,0,0,10" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Schema-v2 history has no brief. It keeps its own overview, unchanged. -->
        <TextBox Text="{Binding SummaryOverview, Mode=OneWay}" Style="{StaticResource ReadingText}"
                 FontSize="14" Margin="0,0,0,10"
                 Visibility="{Binding HasBrief, Converter={StaticResource InvBoolToVis}}" />

        <!-- ===================== What you need to do ===================== -->
        <StackPanel Margin="0,14,0,0" Visibility="{Binding HasBrief, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="What you need to do" FontFamily="{StaticResource DisplayFont}" FontSize="17"
                     FontWeight="SemiBold" Margin="0,0,0,8" />

          <!--
            An empty plan is a finding, not a gap. A short test call or a demo assigns nothing, and
            saying so is far better than manufacturing a task out of "stop the recording".
          -->
          <Border CornerRadius="6" Padding="12,10" Margin="0,0,0,4"
                  Background="{DynamicResource Sunken}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                  Visibility="{Binding HasPlan, Converter={StaticResource InvBoolToVis}}">
            <TextBlock Text="{Binding EmptyPlanNotice}" TextWrapping="Wrap" Foreground="{DynamicResource InkDim}" />
          </Border>

          <ItemsControl ItemsSource="{Binding YourPlan}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,0,8" CornerRadius="6" Padding="14,12"
                        Background="{DynamicResource Sunken}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="34" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Number}" VerticalAlignment="Top"
                               FontFamily="{StaticResource DataFont}" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource You}" />

                    <StackPanel Grid.Column="1">
                      <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Margin="10,0,0,0"
                                VerticalAlignment="Top">
                          <TextBlock Text="{Binding Timing, Converter={StaticResource PlanTiming}}"
                                     Style="{StaticResource ChipText}" />
                        </Border>
                        <TextBox Text="{Binding Title, Mode=OneWay}" Style="{StaticResource ReadingText}"
                                 FontSize="14" FontWeight="SemiBold" />
                      </DockPanel>

                      <TextBox Text="{Binding Detail, Mode=OneWay}" Style="{StaticResource ReadingText}"
                               Margin="0,6,0,0" Foreground="{DynamicResource InkDim}"
                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />

                      <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource Label}"
                                 Foreground="{DynamicResource Remote}"
                                 Visibility="{Binding HasDependency, Converter={StaticResource BoolToVis}}">
                        <Run Text="waits on " /><Run Text="{Binding DependsOn, Mode=OneWay}" />
                      </TextBlock>

                      <WrapPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource Label}" Foreground="{DynamicResource InkDim}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                   Visibility="{Binding HasOwner, Converter={StaticResource BoolToVis}}">
                          <Run Text="owner " /><Run Text="{Binding Owner, Mode=OneWay}" Foreground="{DynamicResource Ink}" />
                        </TextBlock>

                        <TextBlock Style="{StaticResource Label}" Foreground="{DynamicResource InkDim}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                   Visibility="{Binding HasDue, Converter={StaticResource BoolToVis}}">
                          <Run Text="due " /><Run Text="{Binding Due, Mode=OneWay}" Foreground="{DynamicResource Ink}" />
                        </TextBlock>

                        <!-- Said only when the ordering is EchoForge's reasoning rather than the
                             meeting's words. Silence here means somebody actually said it. -->
                        <Border Style="{StaticResource EmptySlot}" Margin="0,0,10,0"
                                Visibility="{Binding IsReasoned, Converter={StaticResource BoolToVis}}">
                          <TextBlock Text="{Binding BasisLabel}" Style="{StaticResource SlotText}" />
                        </Border>

                        <Button Content="Show evidence" Tag="{Binding}" Click="OnShowEvidence"
                                Padding="8,2" FontSize="11" />
                      </WrapPanel>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- ===================== Other people ===================== -->
          <StackPanel Margin="0,14,0,0"
                      Visibility="{Binding HasOtherPeoplesPlan, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Other people's action items" FontFamily="{StaticResource DisplayFont}"
                       FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />

            <ItemsControl ItemsSource="{Binding OtherPeoplesPlan}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,6" CornerRadius="6" Padding="12,10"
                          Background="{DynamicResource Sunken}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                    <StackPanel>
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}"
                                   Foreground="{DynamicResource Remote}" VerticalAlignment="Top"
                                   Margin="0,2,10,0" Text="{Binding Owner}" />
                        <TextBox Text="{Binding Title, Mode=OneWay}" Style="{StaticResource ReadingText}" />
                      </DockPanel>
                      <TextBox Text="{Binding Detail, Mode=OneWay}" Style="{StaticResource ReadingText}"
                               Margin="0,5,0,0" Foreground="{DynamicResource InkDim}"
                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                      <WrapPanel Margin="0,6,0,0">
                        <TextBlock Style="{StaticResource Label}" Foreground="{DynamicResource InkDim}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                   Visibility="{Binding HasDue, Converter={StaticResource BoolToVis}}">
                          <Run Text="due " /><Run Text="{Binding Due, Mode=OneWay}" Foreground="{DynamicResource Ink}" />
                        </TextBlock>
                        <Button Content="Show evidence" Tag="{Binding}" Click="OnShowEvidence"
                                Padding="8,2" FontSize="11" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- ===================== The sections this meeting earned ===================== -->
          <ItemsControl ItemsSource="{Binding BriefSections}" Margin="0,16,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,16">
                  <TextBlock Text="{Binding Heading}" FontFamily="{StaticResource DisplayFont}"
                             FontSize="15" FontWeight="SemiBold" Margin="0,0,0,7" />
                  <ItemsControl ItemsSource="{Binding Blocks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,0,0,8">
                          <Button DockPanel.Dock="Right" Content="Evidence" Tag="{Binding}"
                                  Click="OnShowEvidence" Padding="8,2" FontSize="11"
                                  VerticalAlignment="Top" Margin="10,0,0,0" />
                          <TextBox Text="{Binding Text, Mode=OneWay}" Style="{StaticResource ReadingText}" />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
