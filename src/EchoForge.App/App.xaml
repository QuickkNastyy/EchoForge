<Application x:Class="EchoForge.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:EchoForge.App"
             xmlns:local="clr-namespace:EchoForge.App"
             xmlns:setup="clr-namespace:EchoForge.App.Setup"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>

    <!-- Setup shows readiness as a glyph as well as a colour, so it survives a screenshot. -->
    <setup:TickConverter x:Key="TickConverter" />
    <setup:ReadyBrushConverter x:Key="ReadyBrushConverter" />

    <!-- The device picker shows the negotiated format as "48 kHz · stereo · 16-bit", never a DTO. -->
    <app:AudioFormatConverter x:Key="AudioFormat" />

    <!--
      Application-wide because more than one window needs it. Defined in a single window's
      resources it was present for that window and missing for the library one — a lookup that
      throws when the window is opened rather than when it is written.
    -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <local:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />

    <!--
      Colour is information, never decoration. Amber is always You, teal is always Remote,
      red means capture and appears nowhere else. Everything else is achromatic graphite.
    -->
    <SolidColorBrush x:Key="Ground"   Color="#0D1318" />
    <SolidColorBrush x:Key="Surface"  Color="#141C23" />
    <SolidColorBrush x:Key="Raised"   Color="#1D2831" />
    <SolidColorBrush x:Key="Sunken"   Color="#0A1015" />
    <SolidColorBrush x:Key="Line"     Color="#26313B" />
    <SolidColorBrush x:Key="Ink"      Color="#E6EDF3" />
    <SolidColorBrush x:Key="InkDim"   Color="#8496A6" />
    <SolidColorBrush x:Key="InkFaint" Color="#5B6C7B" />
    <SolidColorBrush x:Key="Focus"    Color="#9CC4F0" />
    <SolidColorBrush x:Key="You"      Color="#F2A93B" />
    <SolidColorBrush x:Key="Remote"   Color="#3FBFC7" />
    <SolidColorBrush x:Key="Rec"      Color="#E2453D" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DataFont">Cascadia Mono, Consolas</FontFamily>

    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource DataFont}" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="Data" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource DataFont}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

    <Style TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Background" Value="{StaticResource Raised}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="6"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <Border.Resources>
                <!--
                  The button's Content is a string, so the ContentPresenter generates a TextBlock
                  for it. Left alone, that TextBlock picks up the application-wide implicit TextBlock
                  style, whose explicit near-white Foreground beats the inherited TextElement one —
                  which is how the primary (light) button rendered white-on-white until a hover
                  darkened the chrome. This template-scoped empty style shadows the app one so the
                  generated text has no explicit Foreground and inherits the button's own, set below.
                -->
                <Style TargetType="TextBlock" />
              </Border.Resources>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
              </Trigger>
              <!-- Pressed dims a touch further, so the click is felt on primary and secondary
                   alike without ever changing the text colour into or out of readability. -->
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.75" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#9CC4F0" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Ink}" />
      <Setter Property="Foreground" Value="#0D1318" />
      <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Rec}" />
      <Setter Property="BorderBrush" Value="{StaticResource Rec}" />
    </Style>

    <!--
      A navigation-rail button: an icon in a 40x40 square, faint until it is the current destination,
      hovered, or focused. Set Tag="active" on the destination that is showing now; it gets the raised
      chrome and the left accent bar from the mockup. Icon colour follows the button's Foreground, so a
      Path inside binds its Stroke to the templated parent.
    -->
    <Style x:Key="RailButton" TargetType="Button">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Accent" Width="3" HorizontalAlignment="Left" Margin="0,11"
                      CornerRadius="2" Background="{StaticResource Ink}" Visibility="Collapsed" />
              <Border x:Name="Chrome" CornerRadius="7" Margin="4,0"
                      Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Raised}" />
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Focus}" />
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
              </Trigger>
              <Trigger Property="Tag" Value="active">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Raised}" />
                <Setter TargetName="Accent" Property="Visibility" Value="Visible" />
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Level meter. Foreground is set per track so colour keeps meaning who is speaking. -->
    <Style x:Key="Meter" TargetType="ProgressBar">
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="1" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Background" Value="{StaticResource Sunken}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border CornerRadius="2"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <Grid Margin="1">
                <Rectangle x:Name="PART_Track" />
                <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                           RadiusX="1" RadiusY="1" Fill="{TemplateBinding Foreground}" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      A minimal ComboBox template. The stock Windows chrome ignores Background on the closed
      state, which left a white bar carrying near-white text.
    -->
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="{StaticResource Raised}" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Row" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#2C3A46" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Background" Value="{StaticResource Raised}" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" CornerRadius="6"
                            Background="{StaticResource Raised}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                      <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                            Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource InkFaint}" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Chrome" Property="Background" Value="#26313B" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>

              <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                HorizontalAlignment="Left" IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />

              <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                     IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="6"
                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="280">
                  <ScrollViewer>
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A small status pill, mono and uppercase, from the mockup. ChipWarn is the red variant. -->
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ChipText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource DataFont}" />
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="Foreground" Value="{StaticResource InkDim}" />
    </Style>

    <!-- Section heading inside the recording detail: mono, uppercase, faint, with a trailing rule. -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource DataFont}" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{StaticResource InkDim}" />
    </Style>

  </Application.Resources>
</Application>
