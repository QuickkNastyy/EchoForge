<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>EchoForge.UnitTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EchoForge.Contracts\EchoForge.Contracts.csproj" />
    <ProjectReference Include="..\..\src\EchoForge.Audio.Windows\EchoForge.Audio.Windows.csproj" />
    <ProjectReference Include="..\..\src\EchoForge.Core\EchoForge.Core.csproj" />
    <ProjectReference Include="..\..\src\EchoForge.Infrastructure\EchoForge.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\EchoForge.App\EchoForge.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Python workers that misbehave on purpose. The real worker cannot answer an unsupported
    protocol version or claim someone else's job, so the supervisor's refusals can only be
    tested against a child that does.
  -->
  <ItemGroup>
    <None Include="PythonStubs\**\*.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

