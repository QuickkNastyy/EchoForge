# ---- Build output ----
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
publish/

# The root artifacts directory holds downloaded output, except for the pinned manifest, which
# is the gate's own authority and must be committed. Anchored to the root with a leading
# slash: an unanchored "artifacts/" also matches source folders such as
# src/EchoForge.Contracts/Artifacts, because Git matches ignore patterns case-insensitively on
# Windows, and it silently swallowed them.
/artifacts/*
!/artifacts/manifest.json
*.user
*.suo
*.userprefs

# ---- IDE ----
.vs/
.vscode/
.idea/
*.swp

# ---- Python worker ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- Runtime data (must NEVER live in the repo) ----
# Recordings, transcripts, summaries, models, logs all belong under
# %LOCALAPPDATA%\EchoForge. These entries are a backstop, not the mechanism.
sessions/
models/
logs/
runtime/
*.wav
*.part.wav
*.gguf
*.bin
*.ct2

# ---- Private test corpus ----
# Consented real meeting audio and its transcripts are never committed.
tests/corpus/
tests/fixtures/private/

# ---- Local machine settings ----
.claude/settings.local.json

# ---- Secrets ----
*.pfx
*.snk
.env
.env.*
!.env.example

# ---- Packaging output ----
packaging/inno/Output/
