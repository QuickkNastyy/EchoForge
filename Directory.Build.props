<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!--
      Globalization-invariant mode is deliberately OFF. WPF needs real culture data for font
      fallback and text layout, and the app formats dates and durations for the user's locale.
      Machine-readable values are written with InvariantCulture explicitly at each call site.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <!--
    Phase 0 is a proof of concept for one machine. Publishing is not in scope until
    Phase 6, so no RuntimeIdentifier or self-contained settings are pinned here yet.
  -->

</Project>
